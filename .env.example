# ─────────────────────────────────────────────
# RESEND — Email sending service
# Get your API key at: https://resend.com/api-keys
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Address that receives the contact form submissions
CONTACT_EMAIL_TO=info@sumsa.com.ar

# "From" address shown in the email (must be a verified domain in Resend)
# Example: noreply@sumsa.com.ar
CONTACT_EMAIL_FROM=noreply@sumsa.com.ar

# ─────────────────────────────────────────────
# SITE
# Full URL of the site (no trailing slash)
# Used for sitemap, robots.txt, and OG metadata
# ─────────────────────────────────────────────
SITE_URL=https://www.sumsa.com.ar

# ─────────────────────────────────────────────
# META (Facebook / Instagram)
# ID del Meta Pixel usado para medir campañas.
# Dejar vacío para desactivar el tracking (ej. en desarrollo local).
# ─────────────────────────────────────────────
META_PIXEL_ID=1074134285367824

# Token de verificación de dominio de Meta Business Manager.
# Se renderiza como <meta name="facebook-domain-verification" ...> en el <head>.
META_DOMAIN_VERIFICATION=4lys5ssbhelfrkhxdv2kvmi34r6ke0

# ─────────────────────────────────────────────
# SUPABASE — Base de datos y almacenamiento de las novedades
# Los valores están en: Project Settings → API
# ─────────────────────────────────────────────

# URL del proyecto. De acá se deriva el dominio permitido en el CSP
# y en images.remotePatterns (ver next.config.ts).
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# "Secret key" en el panel (antes service_role): omite RLS y tiene
# permisos totales sobre la base. Ninguna variable de este archivo
# lleva el prefijo NEXT_PUBLIC_: todas se leen del lado del servidor
# (el ID del pixel baja por prop desde el layout), así nada queda
# expuesto en el bundle del navegador.
#
# La "Publishable key" no se usa: el navegador nunca se conecta a
# Supabase. Las subidas van por URL firmada que emite el servidor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# PANEL DE ADMINISTRACIÓN (/admin)
# Acceso por URL directa, sin enlace visible en el sitio.
#
# El usuario y la contraseña NO van acá: viven en la tabla
# admin_usuarios, hasheados con pgcrypto. Los crea la migración
# supabase/migrations/0001_novedades.sql y se cambian desde
# /admin/cuenta.
# ─────────────────────────────────────────────

# Clave con la que se firma la cookie de sesión. Mínimo 32 caracteres.
# Generar una al azar, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarla invalida todas las sesiones activas.
ADMIN_SESSION_SECRET=generar-una-clave-aleatoria-de-al-menos-32-caracteres
